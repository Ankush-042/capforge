# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=gsk_your_key_here
PORT=3000

# Email verification. ENTIRELY OPTIONAL.
# With these unset, the app runs exactly as it does today: accounts are
# created, everyone can sign in, nothing is gated. Verification links simply
# are not sent. Proven with a test covering unconfigured, network-down and
# HTTP-500, all of which return cleanly without touching signup.
RESEND_API_KEY=
EMAIL_FROM=CapForge <onboarding@yourdomain.com>
APP_URL=http://localhost:5173

# A last resort, reached only when every Groq key above has failed.
# Any OpenAI-compatible host works: OpenRouter, Together, Cerebras, or a
# local model. Leave these unset and the behaviour is exactly as if this
# feature did not exist.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
# FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
